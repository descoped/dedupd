// Version from Cargo.toml — auto-synced at build time
#include "Version.xcconfig"

// Apple developer team that signs the app. Not a secret: every signed binary
// carries it. Committed so a clean clone builds without any setup.
DEVELOPMENT_TEAM = 4348AJW8CG

// The public half of the key that signs every release for the updater
// (Sparkle's EdDSA key). Not a secret. Its private half is in the owner's
// keychain (made with Sparkle's generate_keys, 2026-11-21); while this is empty
// the app offers no update checks.
SPARKLE_PUBLIC_KEY = EgXhrAg8jNX+t1mkb0Va3rJJwjnPhjROlJIdlIATxtM=

// Developer overrides — imports Local.xcconfig if it exists.
// Local.xcconfig is gitignored; copy Local.xcconfig.example to create it.
#include? "Local.xcconfig"
